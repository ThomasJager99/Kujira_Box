# ── Backrest ───────────────────────────────────────────────────────────────
# Copy to .env and adjust. The restic repo PASSWORD is set in the web UI on
# first run — write it down somewhere safe (lose it = lose the backups).

# Image version. Pin it. Releases:
# https://github.com/garethgeorge/backrest/releases
# (also :latest and :scratch tags exist on ghcr.io/garethgeorge/backrest)
BACKREST_VERSION=v1.14.1

# ── Host exposure ──────────────────────────────────────────────────────────
#   127.0.0.1 = host-only; reach via your reverse proxy (recommended — the UI
#               can trigger restores, so don't leave it open on the LAN)
#   0.0.0.0   = reachable on the LAN (bypasses UFW — hardening 07)
LISTEN_ADDR=0.0.0.0
BACKREST_PORT=9898

TZ=Europe/Berlin

# ── What to back up ────────────────────────────────────────────────────────
# Host path mounted read-only at /userdata inside the container. Point it at
# the data you care about (e.g. where your docker volumes / files live).
BACKUP_SOURCE=/srv

# ── Resource limits ────────────────────────────────────────────────────────
BACKREST_MEM_LIMIT=1g
BACKREST_MEM_RESERVATION=256m
BACKREST_CPUS=2.0
BACKREST_PIDS_LIMIT=200
