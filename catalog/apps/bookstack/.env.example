# BookStack — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Images ---
BOOKSTACK_IMAGE=lscr.io/linuxserver/bookstack
# LinuxServer publishes 'latest' plus version tags; pin one for reproducibility.
BOOKSTACK_VERSION=latest
MARIADB_IMAGE=mariadb
MARIADB_VERSION=11

# --- File ownership ---
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- Networking ---
BOOKSTACK_PORT=6875
# Must match how you actually reach BookStack (scheme + host [+ port]).
BOOKSTACK_APP_URL=http://localhost:6875

# --- Security ---
# Laravel application key. Generate once and keep stable:
#   echo "base64:$(openssl rand -base64 32)"
BOOKSTACK_APP_KEY=

# --- Database (MariaDB) ---
DB_DATABASE=bookstack
DB_USER=bookstack
DB_PASS=
DB_ROOT_PASSWORD=

# --- Resource limits ---
BOOKSTACK_MEM_LIMIT=1g
BOOKSTACK_MEM_RESERVATION=128m
BOOKSTACK_CPUS=1.0
MARIADB_MEM_LIMIT=512m
MARIADB_MEM_RESERVATION=128m
MARIADB_CPUS=1.0
