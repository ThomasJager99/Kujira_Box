# ── Changedetection.io ─────────────────────────────────────────────────────
# Copy to .env and adjust. No secrets required; set a UI password in the app.

# Image versions. Pin the app; the browser sidecar tracks a rolling tag.
# App releases: https://github.com/dgtlmoon/changedetection.io/releases
CHANGEDETECTION_VERSION=0.70.3
SOCKPUPPET_VERSION=latest

# Public URL the UI is reached on (used in notification links). Behind a proxy
# this is your https host.
BASE_URL=http://localhost:5000

# Host port → container :5000
CHANGEDETECTION_PORT=5000

# Timezone (affects schedules + timestamps).
TZ=Europe/Berlin

# Concurrency — how many page checks run at once (app) and max Chrome processes
# (browser). Keep modest so you don't peg CPU or hammer the sites you watch.
FETCH_WORKERS=10
MAX_CHROME=10

# Chrome shared memory + the browser's resource ceilings.
BROWSER_SHM_SIZE=2gb
BROWSER_MEM_LIMIT=1g
BROWSER_CPUS=2.0

# ── App resource limits ───────────────────────────────────────────────────
CHANGEDETECTION_MEM_LIMIT=512m
CHANGEDETECTION_CPUS=1.0
CHANGEDETECTION_PIDS_LIMIT=300
