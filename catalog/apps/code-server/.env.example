# code-server — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Image (PINNED) ---
CODE_SERVER_IMAGE=codercom/code-server
CODE_SERVER_VERSION=4.143.1

# --- Networking ---
CODE_SERVER_PORT=8080

# --- Timezone ---
TZ=Etc/UTC

# --- Security ---
# Web login password (required). Generate: openssl rand -hex 16
CODE_SERVER_PASSWORD=

# --- Where your code lives on the host ---
PROJECTS_PATH=./projects

# --- Resource limits ---
CODE_SERVER_MEM_LIMIT=2g
CODE_SERVER_MEM_RESERVATION=256m
CODE_SERVER_CPUS=2.0
