# ── Excalidraw ─────────────────────────────────────────────────────────────
# Copy to .env and adjust. No secrets — the app is a static frontend.

# Image version. Excalidraw's Docker Hub tags aren't clean semver — `latest`
# tracks the newest build. For reproducibility, pin by digest from Docker Hub
# instead (see README). Current app release at time of writing: v0.18.1.
EXCALIDRAW_VERSION=latest

# ── Host exposure ──────────────────────────────────────────────────────────
#   127.0.0.1 = host-only; reach via your reverse proxy (recommended)
#   0.0.0.0   = reachable on the LAN (and bypasses UFW — hardening 07)
LISTEN_ADDR=0.0.0.0
EXCALIDRAW_PORT=5090

# ── Resource limits ───────────────────────────────────────────────────────
EXCALIDRAW_MEM_LIMIT=256m
EXCALIDRAW_CPUS=0.5
EXCALIDRAW_PIDS_LIMIT=100
