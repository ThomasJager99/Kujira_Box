# Filebrowser — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Image ---
FB_IMAGE=filebrowser/filebrowser
# Pin a release tag (e.g. v2.x.x) from the registry for reproducible rebuilds.
FB_VERSION=latest

# --- File ownership (match the user that owns the managed folder) ---
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- Networking ---
FB_PORT=8081

# --- The folder on the host you want to manage ---
FB_ROOT_PATH=./data

# --- Resource limits ---
FB_MEM_LIMIT=256m
FB_MEM_RESERVATION=32m
FB_CPUS=0.5
