# --- App ---------------------------------------------------------------------
# APP_KEY must be EXACTLY 32 characters. Generate one with:
#   head /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 32 ; echo
APP_KEY=CHANGE_ME_to_a_32_character_string

# Public URL where you reach Firefly. Behind a reverse proxy use the real
# https:// domain and uncomment TRUSTED_PROXIES below.
APP_URL=http://localhost:8080

# Host port to publish the web interface on (container always listens on 8080).
APP_PORT=8080

TZ=Europe/Berlin

# Container memory limits (see docker-compose). Raise if you have RAM to spare.
APP_MEM_LIMIT=512m
DB_MEM_LIMIT=512m

# If you run behind a reverse proxy (Caddy/Traefik/nginx), set this so Firefly
# trusts the forwarded headers. "**" trusts all — fine on a private homelab.
# TRUSTED_PROXIES=**

# --- Database (must match the db service in docker-compose) -------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=CHANGE_ME_to_a_strong_db_password

# --- Cron --------------------------------------------------------------------
# Token the cron container uses to trigger daily jobs. 32 alphanumeric chars,
# generate the same way as APP_KEY.
STATIC_CRON_TOKEN=CHANGE_ME_to_a_32_character_token

# --- Privacy / telemetry ------------------------------------------------------
# Keep Firefly from phoning home for update checks / usage stats.
APP_ENV=production
SEND_TELEMETRY=false
SEND_ERROR_MESSAGE=false
