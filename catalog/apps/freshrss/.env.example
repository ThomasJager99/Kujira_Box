# FreshRSS — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Image ---
FRESHRSS_IMAGE=freshrss/freshrss
FRESHRSS_VERSION=latest

# --- Networking ---
FRESHRSS_PORT=8083

# --- Timezone ---
TZ=Etc/UTC

# --- Feed refresh cron (standard cron spec) ---
FRESHRSS_CRON_MIN=*/20 * * * *     # refresh all feeds every 20 minutes

# --- Resource limits ---
FRESHRSS_MEM_LIMIT=512m
FRESHRSS_MEM_RESERVATION=64m
FRESHRSS_CPUS=1.0
