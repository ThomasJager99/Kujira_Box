# ── Ghost ──────────────────────────────────────────────────────────────────
# Copy to .env and fill in. Keep the DB passwords out of git.

# Image versions. Pin both. Ghost releases:
# https://github.com/TryGhost/Ghost/releases   (image tag = major, e.g. 6-alpine)
GHOST_VERSION=6-alpine
MYSQL_VERSION=8.0

# Public URL readers reach the blog on — REQUIRED, must match exactly (Ghost
# redirects to it). Behind a reverse proxy this is your https host.
GHOST_URL=https://blog.example.com

# ── Host exposure ──────────────────────────────────────────────────────────
#   127.0.0.1 = host-only; reach via your reverse proxy (recommended)
#   0.0.0.0   = reachable on the LAN (bypasses UFW — hardening 07)
LISTEN_ADDR=0.0.0.0
GHOST_PORT=2368

# ── Database (internal, not exposed) ──────────────────────────────────────
MYSQL_DATABASE=ghost
MYSQL_USER=ghost
# Generate strong values:  openssl rand -hex 24  (for each)
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── Resource limits ───────────────────────────────────────────────────────
GHOST_MEM_LIMIT=1g
GHOST_CPUS=1.0
GHOST_PIDS_LIMIT=300
MYSQL_MEM_LIMIT=512m
MYSQL_CPUS=1.0
MYSQL_PIDS_LIMIT=200
