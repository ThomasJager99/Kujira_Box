# ── Grist ──────────────────────────────────────────────────────────────────
# Copy to .env and adjust. Generate the two secrets with: openssl rand -hex 32

# Image version. Pin it. Releases:
# https://github.com/gristlabs/grist-core/releases
GRIST_VERSION=1.7.22

# ── Host exposure ──────────────────────────────────────────────────────────
#   127.0.0.1 = host-only; reach via your reverse proxy (recommended)
#   0.0.0.0   = reachable on the LAN (bypasses UFW — hardening 07)
LISTEN_ADDR=0.0.0.0
GRIST_PORT=8484

# Public URL once behind a domain/proxy (else leave default).
GRIST_HOME_URL=http://localhost:8484

# ── Admin + secrets ────────────────────────────────────────────────────────
# The admin account created on a fresh install.
GRIST_DEFAULT_EMAIL=you@example.com
# openssl rand -hex 32
GRIST_SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32
# Protects the admin panel. openssl rand -hex 32
GRIST_BOOT_KEY=CHANGE_ME_openssl_rand_hex_32

# Formula sandbox: gvisor (default) or pyodide (WASM, no extra privileges).
GRIST_SANDBOX_FLAVOR=gvisor

# ── Resource limits ────────────────────────────────────────────────────────
GRIST_MEM_LIMIT=1g
GRIST_MEM_RESERVATION=256m
GRIST_CPUS=1.5
GRIST_PIDS_LIMIT=200
