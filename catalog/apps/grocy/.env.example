# ── Grocy ──────────────────────────────────────────────────────────────────
# Copy to .env and adjust. No secrets here — Grocy has no DB of its own and
# ships with built-in demo/login handling; put real auth in your reverse proxy.

# Image version. LinuxServer.io does NOT publish bare semver tags — pin to a
# concrete build from the registry, e.g.  version-v4.7.1-ls256
# (check: https://github.com/linuxserver/docker-grocy/pkgs/container/grocy).
# `latest` tracks the newest build; pin for reproducibility.
GROCY_VERSION=latest

# Host port → container :80
GROCY_HTTP_PORT=9283

# File ownership for the /config volume + timezone (LinuxServer convention).
# Match PUID/PGID to the host user that should own the data (`id -u` / `id -g`).
PUID=1000
PGID=1000
TZ=Europe/Berlin

# ── Resource limits ──────────────────────────────────────────────────────
GROCY_MEM_LIMIT=512m
GROCY_MEM_RESERVATION=128m
GROCY_CPUS=1.0
