# Home Assistant — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Image (PINNED — HA uses calendar versions; pin and upgrade deliberately) ---
HOMEASSISTANT_IMAGE=ghcr.io/home-assistant/home-assistant
HOMEASSISTANT_VERSION=2026.10.2

# --- Timezone (important for automations/schedules) ---
TZ=Etc/UTC

# --- Access ---
# With network_mode: host the UI is served on the HOST's port 8123 (not
# remappable here). To change the port, set it in HA's configuration.yaml
# (http: server_port:) instead.

# --- Resource limits ---
HOMEASSISTANT_MEM_LIMIT=2g
HOMEASSISTANT_MEM_RESERVATION=256m
HOMEASSISTANT_CPUS=2.0
