# Images
LINKWARDEN_IMAGE=ghcr.io/linkwarden/linkwarden:latest
POSTGRES_IMAGE=postgres:16-alpine
MEILI_IMAGE=getmeili/meilisearch:v1.13.3

# Web port (host side; container listens on 3000)
LINKWARDEN_PORT=3000

# Public URL (used by NextAuth) — set to your real address
# (e.g. http://192.168.1.50:3000 or https://links.example.com)
NEXTAUTH_URL=http://localhost:3000

# Session secret — generate: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_nextauth_secret

# PostgreSQL password (used in DATABASE_URL)
POSTGRES_PASSWORD=CHANGE_ME_db_password

# Meilisearch master key — generate: openssl rand -base64 32
MEILI_MASTER_KEY=CHANGE_ME_meili_master_key

# Memory limit for the app
LINKWARDEN_MEM_LIMIT=1g
