# ── Mattermost ─────────────────────────────────────────────────────────────
# Copy to .env and fill in. Keep the DB password out of git.

# Image versions. Pin both. Mattermost release tags:
# https://github.com/mattermost/mattermost/releases   (use the number, e.g. 12.0.2)
MATTERMOST_VERSION=12.0.2
POSTGRES_VERSION=16-alpine

# Public URL users reach Mattermost on (used for links, CORS, push). Behind a
# reverse proxy this is your https host, NOT http://host:8065.
MM_SITE_URL=https://chat.example.com

# Host port → container :8065
MATTERMOST_PORT=8065

# ── Database (internal, not exposed) ──────────────────────────────────────
POSTGRES_USER=mattermost
POSTGRES_DB=mattermost
# Generate a strong one:  openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Timezone ──────────────────────────────────────────────────────────────
TZ=Europe/Berlin

# ── Resource limits ───────────────────────────────────────────────────────
MATTERMOST_MEM_LIMIT=2g
MATTERMOST_CPUS=2.0
MATTERMOST_PIDS_LIMIT=300
POSTGRES_MEM_LIMIT=512m
POSTGRES_CPUS=1.0
POSTGRES_PIDS_LIMIT=200
