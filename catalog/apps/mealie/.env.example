# Images (pin MEALIE_IMAGE to a specific version for production, e.g. :v3.28.0)
MEALIE_IMAGE=ghcr.io/mealie-recipes/mealie:latest
POSTGRES_IMAGE=postgres:17

# Web port (host side; container listens on 9000)
MEALIE_PORT=9925

# Public URL — used to build links; set to the address you actually use
# (e.g. http://192.168.1.50:9925 or https://recipes.example.com)
BASE_URL=http://localhost:9925

# Allow new user signup — turn off after you've created your account(s)
ALLOW_SIGNUP=false

TZ=Europe/Berlin

# Database — used by BOTH the db container and Mealie (keep in sync)
POSTGRES_USER=mealie
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=mealie

# Memory limit for the app
MEALIE_MEM_LIMIT=1g
