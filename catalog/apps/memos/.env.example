# Memos — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Image (PINNED — it holds your notes, so pin and upgrade deliberately) ---
MEMOS_IMAGE=neosmemo/memos
MEMOS_VERSION=0.31.0

# --- Networking ---
MEMOS_PORT=5230

# --- Behaviour ---
MEMOS_MODE=prod
TZ=Etc/UTC

# --- Resource limits ---
MEMOS_MEM_LIMIT=256m
MEMOS_MEM_RESERVATION=32m
MEMOS_CPUS=0.5
