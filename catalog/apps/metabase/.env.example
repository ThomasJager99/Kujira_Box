# ── Metabase ───────────────────────────────────────────────────────────────
# Copy to .env and fill in. Keep the DB password out of git.

# Image versions. Pin both. Metabase OSS releases use v0.x tags:
# https://github.com/metabase/metabase/releases
METABASE_VERSION=v0.65.6
POSTGRES_VERSION=16-alpine

# JVM heap cap — keep it comfortably under METABASE_MEM_LIMIT.
METABASE_JAVA_OPTS=-Xmx1g

# ── Host exposure ──────────────────────────────────────────────────────────
#   127.0.0.1 = host-only; reach via your reverse proxy (recommended)
#   0.0.0.0   = reachable on the LAN (bypasses UFW — hardening 07)
LISTEN_ADDR=0.0.0.0
METABASE_PORT=3000

# ── Application database (internal, not exposed) ──────────────────────────
# This stores Metabase's OWN settings/questions/dashboards, NOT the data you
# analyze (you connect to those databases from inside the Metabase UI).
POSTGRES_USER=metabase
POSTGRES_DB=metabaseapp
# Generate a strong one:  openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Resource limits ───────────────────────────────────────────────────────
METABASE_MEM_LIMIT=2g
METABASE_CPUS=2.0
METABASE_PIDS_LIMIT=300
POSTGRES_MEM_LIMIT=512m
POSTGRES_CPUS=1.0
POSTGRES_PIDS_LIMIT=200
