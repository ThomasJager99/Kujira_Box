# Nextcloud — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Images ---
NEXTCLOUD_IMAGE=nextcloud
NEXTCLOUD_VERSION=stable       # or pin a major, e.g. 30-apache
POSTGRES_IMAGE=postgres
POSTGRES_VERSION=16-alpine
REDIS_IMAGE=redis
REDIS_VERSION=7-alpine

# --- Networking ---
NEXTCLOUD_PORT=8080
# Space-separated hostnames/IPs allowed to serve this instance.
# Add every address you'll actually use, e.g. "localhost 192.168.1.10 cloud.example.com"
NEXTCLOUD_TRUSTED_DOMAINS=localhost

# --- First-run admin account (created only on the very first start) ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=

# --- Database (PostgreSQL) ---
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=

# --- Cache / file locking (Redis) ---
REDIS_PASSWORD=

# --- PHP tuning ---
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_LIMIT=2G            # max upload size; raise for big files

# --- Reverse proxy (uncomment the matching lines in compose if you use one) ---
# OVERWRITEPROTOCOL=https
# OVERWRITECLIURL=https://cloud.example.com
# TRUSTED_PROXIES=172.16.0.0/12

# --- Resource limits ---
NEXTCLOUD_MEM_LIMIT=1g
NEXTCLOUD_MEM_RESERVATION=256m
NEXTCLOUD_CPUS=2.0
NEXTCLOUD_CRON_MEM_LIMIT=512m
NEXTCLOUD_CRON_MEM_RESERVATION=64m
NEXTCLOUD_CRON_CPUS=1.0
POSTGRES_MEM_LIMIT=512m
POSTGRES_MEM_RESERVATION=128m
POSTGRES_CPUS=1.0
REDIS_MEM_LIMIT=256m
REDIS_MEM_RESERVATION=32m
REDIS_CPUS=0.5
