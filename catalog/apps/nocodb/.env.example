# ── NocoDB ─────────────────────────────────────────────────────────────────
# Copy to .env and fill in. Keep the DB password + JWT secret out of git.

# Image versions. Pin both. NocoDB releases:
# https://github.com/nocodb/nocodb/releases
NOCODB_VERSION=2026.10.1
POSTGRES_VERSION=16-alpine

# Secret that signs auth tokens — generate ONCE and keep stable (changing it
# logs everyone out):  openssl rand -hex 32
NC_AUTH_JWT_SECRET=

# Public URL the app is reached on (used for invite/share links). Behind a
# reverse proxy this is your https host.
NC_PUBLIC_URL=http://localhost:8080

# ── Host exposure ──────────────────────────────────────────────────────────
#   127.0.0.1 = host-only; reach via your reverse proxy (recommended)
#   0.0.0.0   = reachable on the LAN (bypasses UFW — hardening 07)
LISTEN_ADDR=0.0.0.0
NOCODB_PORT=8080

# ── Database (internal, not exposed) ──────────────────────────────────────
POSTGRES_USER=nocodb
POSTGRES_DB=nocodb
# Generate a strong one:  openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Resource limits ───────────────────────────────────────────────────────
NOCODB_MEM_LIMIT=1g
NOCODB_CPUS=1.0
NOCODB_PIDS_LIMIT=300
POSTGRES_MEM_LIMIT=512m
POSTGRES_CPUS=1.0
POSTGRES_PIDS_LIMIT=200
