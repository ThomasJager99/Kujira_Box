# ── PairDrop ──────────────────────────────────────────────────────────────
# Copy to .env and adjust. No secrets — PairDrop stores nothing; transfers are
# peer-to-peer and never hit the server.

# Image version. LinuxServer.io uses tags like  version-v1.11.2  (not bare
# semver). Pin to a concrete build from the registry rather than `latest`:
# https://github.com/linuxserver/docker-pairdrop/pkgs/container/pairdrop
PAIRDROP_VERSION=version-v1.11.2

# Host port → container :3000
PAIRDROP_PORT=3000

# LinuxServer ownership + timezone. Match PUID/PGID to your host user.
PUID=1000
PGID=1000
TZ=Europe/Berlin

# Rate-limit the signaling endpoint (useful only if publicly exposed).
PAIRDROP_RATE_LIMIT=false

# WebSocket fallback when direct WebRTC P2P is blocked (e.g. strict firewalls /
# different subnets). Off by default — turn on if transfers won't start.
PAIRDROP_WS_FALLBACK=false

# ── Resource limits ───────────────────────────────────────────────────────
PAIRDROP_MEM_LIMIT=256m
PAIRDROP_CPUS=0.5
