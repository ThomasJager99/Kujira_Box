# Images
PAPERLESS_IMAGE=ghcr.io/paperless-ngx/paperless-ngx:latest
POSTGRES_IMAGE=postgres:16
REDIS_IMAGE=redis:7
GOTENBERG_IMAGE=gotenberg/gotenberg:8
TIKA_IMAGE=apache/tika:latest

# Web
PAPERLESS_PORT=8000
# Public URL where you reach Paperless (behind a proxy use your https:// domain)
PAPERLESS_URL=http://localhost:8000
PAPERLESS_TIME_ZONE=Europe/Berlin
# OCR languages (install codes: eng, deu, rus, ...); combine with +
PAPERLESS_OCR_LANGUAGE=eng+deu

# Django secret key — generate: openssl rand -base64 48
PAPERLESS_SECRET_KEY=CHANGE_ME_secret_key

# Initial superuser, created on first start
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=CHANGE_ME_admin_password

# Database — used by BOTH the db container and Paperless (keep in sync)
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=CHANGE_ME_db_password

# Memory limit for the main app
PAPERLESS_MEM_LIMIT=1g
