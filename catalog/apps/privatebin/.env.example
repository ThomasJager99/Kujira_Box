# ── PrivateBin ─────────────────────────────────────────────────────────────
# Copy to .env and adjust. No secrets — encryption happens in the browser, the
# server only ever holds ciphertext.

# Image version. Pin it. PrivateBin releases:
# https://github.com/PrivateBin/PrivateBin/releases
# (Docker image: https://hub.docker.com/r/privatebin/nginx-fpm-alpine)
PRIVATEBIN_VERSION=2.1.1

# ── Host exposure ──────────────────────────────────────────────────────────
#   127.0.0.1 = host-only; reach via your reverse proxy (recommended)
#   0.0.0.0   = reachable on the LAN (bypasses UFW — hardening 07)
LISTEN_ADDR=0.0.0.0
PRIVATEBIN_PORT=8094

# Timezone (affects paste timestamps).
TZ=Europe/Berlin

# ── Resource limits ───────────────────────────────────────────────────────
PRIVATEBIN_MEM_LIMIT=256m
PRIVATEBIN_CPUS=0.5
PRIVATEBIN_PIDS_LIMIT=150
