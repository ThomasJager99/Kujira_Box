# SillyTavern — copy this file to .env (same folder) and adjust if needed.

# --- Image ---
ST_IMAGE=ghcr.io/sillytavern/sillytavern
ST_VERSION=latest        # or pin a version, e.g. 1.13.4

# --- Networking ---
ST_PORT=8000

# --- Timezone ---
TZ=Europe/Berlin

# --- Resource limits ---
ST_MEM_LIMIT=2g
ST_MEM_RESERVATION=256m
ST_CPUS=2.0
