# ── Snipe-IT ───────────────────────────────────────────────────────────────
# Copy to .env and fill in. Keep the DB passwords + APP_KEY out of git.

# Image versions. Pin both. Snipe-IT releases:
# https://github.com/snipe/snipe-it/releases
SNIPEIT_VERSION=v8.8.4
MARIADB_VERSION=11

# Laravel app key — REQUIRED, generate ONCE and keep it stable (it encrypts
# stored data; changing it breaks decryption):
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# Public URL you reach Snipe-IT on (behind a proxy, your https host).
APP_URL=http://localhost:8095

# ── Host exposure ──────────────────────────────────────────────────────────
#   127.0.0.1 = host-only; reach via your reverse proxy (recommended)
#   0.0.0.0   = reachable on the LAN (bypasses UFW — hardening 07)
LISTEN_ADDR=0.0.0.0
SNIPEIT_PORT=8095

# ── Database (internal, not exposed) ──────────────────────────────────────
MYSQL_DATABASE=snipeit
MYSQL_USER=snipeit
# Generate strong values:  openssl rand -hex 24  (each)
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── Resource limits ───────────────────────────────────────────────────────
SNIPEIT_MEM_LIMIT=1g
SNIPEIT_CPUS=1.0
SNIPEIT_PIDS_LIMIT=300
MARIADB_MEM_LIMIT=512m
MARIADB_CPUS=1.0
MARIADB_PIDS_LIMIT=200
