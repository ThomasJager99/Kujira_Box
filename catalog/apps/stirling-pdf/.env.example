# Image — use ':latest-fat' if you want the office-doc conversions + OCR features
STIRLING_IMAGE=docker.stirlingpdf.com/stirlingtools/stirling-pdf:latest

# Web port (host side; container listens on 8080)
STIRLING_PORT=8080

# UI language (e.g. en-GB, en-US, de-DE, ru-RU)
SYSTEM_DEFAULTLOCALE=en-GB

# Require login? Off by default for a private homelab; set true to enable accounts.
SECURITY_ENABLELOGIN=false

# Memory limit (Java app; the -fat image with LibreOffice wants more)
STIRLING_MEM_LIMIT=2g
