# Syncthing — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Image ---
SYNCTHING_IMAGE=syncthing/syncthing
SYNCTHING_VERSION=latest

# --- Identity ---
SYNCTHING_HOSTNAME=homelab   # the name this device shows to your other devices

# --- File ownership (match the user that owns your data folders) ---
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- Ports ---
SYNCTHING_GUI_PORT=8384        # web UI — keep it LAN/VPN only
SYNCTHING_SYNC_PORT=22000      # tcp + udp, must be reachable by remote devices
SYNCTHING_DISCOVERY_PORT=21027 # udp, local network discovery

# --- Real data folders to sync (referenced by extra bind mounts in compose) ---
# DOCS_PATH=/srv/documents

# --- Resource limits ---
SYNCTHING_MEM_LIMIT=512m
SYNCTHING_MEM_RESERVATION=128m
SYNCTHING_CPUS=1.0
