# Image
VW_IMAGE=vaultwarden/server:latest

# Host port to publish the web vault on (container listens on 80)
VW_PORT=8000

# Public URL where you reach Vaultwarden — REQUIRED for attachments, WebAuthn
# and emails. Use your real https:// domain in production.
DOMAIN=http://localhost:8000

# Allow new account registration. Set to false once your account(s) exist,
# so nobody else can sign up.
SIGNUPS_ALLOWED=true

# Token for the /admin panel. Generate a strong one:
#   openssl rand -base64 48
# (Newer Vaultwarden prefers an Argon2 hash via `vaultwarden hash`; a plain
#  token still works but prints a warning.)
ADMIN_TOKEN=CHANGE_ME_admin_token

# Container memory limit
VW_MEM_LIMIT=256m
