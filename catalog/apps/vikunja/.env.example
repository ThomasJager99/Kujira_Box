# Vikunja — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Images (PINNED — upgrade deliberately, don't float on :latest) ---
VIKUNJA_IMAGE=vikunja/vikunja
VIKUNJA_VERSION=0.24           # pin a known version; bump when you choose to
POSTGRES_IMAGE=postgres
POSTGRES_VERSION=16-alpine

# --- Networking ---
VIKUNJA_PORT=3456
# The address users reach Vikunja by, INCLUDING scheme + port (or your domain).
VIKUNJA_PUBLICURL=http://localhost:3456

# --- Security ---
# Signs login sessions. Generate once and keep stable: openssl rand -hex 32
VIKUNJA_JWTSECRET=

# --- Database (PostgreSQL) ---
POSTGRES_DB=vikunja
POSTGRES_USER=vikunja
POSTGRES_PASSWORD=

# --- Resource limits ---
VIKUNJA_MEM_LIMIT=512m
VIKUNJA_MEM_RESERVATION=64m
VIKUNJA_CPUS=1.0
POSTGRES_MEM_LIMIT=256m
POSTGRES_MEM_RESERVATION=64m
POSTGRES_CPUS=1.0
