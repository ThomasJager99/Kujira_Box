# Copy this file to .env in the same directory as docker-compose.yml
# Docker Compose picks up .env automatically — no extra flags needed.
#
# Do not commit your filled-in .env to a public repository.

# ---- IMAGE VERSIONS ----
# Pin a specific version instead of latest once your setup is stable —
# this makes upgrades intentional instead of automatic on every restart.
MONGO_IMAGE_TAG=7
WEKAN_IMAGE_TAG=latest

# ---- NETWORK ----
# Port on the host used to reach WeKan (http://<host>:<port>)
WEKAN_PORT=8080

# The address WeKan sees itself at — your server's domain or IP.
# MUST be filled in before the first run, otherwise links/avatars will break.
ROOT_URL=http://localhost

# ---- TIMEZONE ----
TZ=UTC

# ---- MEMORY ----
# Check available RAM on your server (`free -h`) before setting these.
# WeKan (Meteor/Node) needs real headroom or it crashes with
# "JavaScript heap out of memory" on startup — 1g is a safe minimum.
DB_MEM_LIMIT=1g
DB_MEM_RESERVATION=2g
APP_MEM_LIMIT=1g
APP_MEM_RESERVATION=2g

# MongoDB cache size (in GB, decimals allowed). Rule of thumb: ~50% of
# DB_MEM_LIMIT minus ~1GB. Recalculate this if you change DB_MEM_LIMIT.
MONGO_CACHE_SIZE_GB=0.25

# ---- MAIL (notifications, password reset) ----
# Leave empty if SMTP isn't configured — WeKan will still start fine.
MAIL_URL=
MAIL_FROM=Wekan Notifications <noreply.wekan@example.com>

