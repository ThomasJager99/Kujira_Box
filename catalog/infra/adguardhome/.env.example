# AdGuard Home — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Image ---
ADGUARD_IMAGE=adguard/adguardhome
ADGUARD_VERSION=latest

# --- Ports ---
ADGUARD_DNS_PORT=53     # the DNS port clients point at; must be free on the host
ADGUARD_WEB_PORT=3000   # setup wizard AND admin UI (set the UI to 3000 in the wizard)

# --- Resource limits ---
ADGUARD_MEM_LIMIT=512m
ADGUARD_MEM_RESERVATION=128m
ADGUARD_CPUS=1.0
