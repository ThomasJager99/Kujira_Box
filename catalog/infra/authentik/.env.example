# authentik — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Images (PINNED) ---
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_VERSION=2026.8.3      # pin exactly; authentik uses date-based versions
POSTGRES_IMAGE=postgres
POSTGRES_VERSION=16-alpine
REDIS_IMAGE=redis
REDIS_VERSION=7-alpine

# --- Ports ---
AUTHENTIK_HTTP_PORT=9000
AUTHENTIK_HTTPS_PORT=9443

# --- Security ---
# Master secret for sessions/tokens. Generate once and keep stable:
#   openssl rand -base64 60   (then strip newlines)
AUTHENTIK_SECRET_KEY=

# --- Database (PostgreSQL) ---
PG_DB=authentik
PG_USER=authentik
PG_PASS=

# --- Resource limits ---
AUTHENTIK_SERVER_MEM_LIMIT=1g
AUTHENTIK_SERVER_MEM_RESERVATION=256m
AUTHENTIK_SERVER_CPUS=2.0
AUTHENTIK_WORKER_MEM_LIMIT=1g
AUTHENTIK_WORKER_MEM_RESERVATION=256m
AUTHENTIK_WORKER_CPUS=2.0
POSTGRES_MEM_LIMIT=512m
POSTGRES_MEM_RESERVATION=128m
POSTGRES_CPUS=1.0
REDIS_MEM_LIMIT=256m
REDIS_MEM_RESERVATION=32m
REDIS_CPUS=0.5
