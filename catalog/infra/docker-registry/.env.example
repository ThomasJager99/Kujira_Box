# ── Private Docker Registry + UI ───────────────────────────────────────────
# Copy to .env and adjust. The login lives in the htpasswd file (see README),
# not here.

# Image versions. Pin both.
# Registry: https://github.com/distribution/distribution/releases
# UI:       https://github.com/Joxit/docker-registry-ui/releases
REGISTRY_VERSION=3.1.2
REGISTRY_UI_VERSION=2.6.0

# ── Host exposure ──────────────────────────────────────────────────────────
# Bind address for the published UI port.
#   127.0.0.1 = host-only; reach it through your reverse proxy (recommended)
#   0.0.0.0   = reachable from the whole LAN (and bypasses UFW — see hardening 07)
LISTEN_ADDR=0.0.0.0
REGISTRY_UI_PORT=5080

# Title shown in the web UI.
REGISTRY_TITLE=Private Docker Registry

# Folder containing your htpasswd file (mounted read-only at /auth).
AUTH_DIR=./auth

# ── Resource limits ───────────────────────────────────────────────────────
REGISTRY_MEM_LIMIT=1g
REGISTRY_CPUS=1.0
REGISTRY_PIDS_LIMIT=200
UI_MEM_LIMIT=256m
UI_CPUS=0.5
UI_PIDS_LIMIT=100
