# Image
DOCKGE_IMAGE=louislam/dockge:1

# Host port to publish the web UI on (container listens on 5001)
DOCKGE_PORT=5001

# Where Dockge stores and manages your compose stacks on the host.
# Must be the SAME path inside and outside the container.
DOCKGE_STACKS_DIR=/opt/stacks

# Container memory limit
DOCKGE_MEM_LIMIT=256m
