# ── Garage ─────────────────────────────────────────────────────────────────
# Copy to .env and adjust. The real secrets (rpc_secret, admin_token) live in
# garage.toml, NOT here.

# Image version. Pin it. Releases:
# https://github.com/deuxfleurs-org/garage/tags
# (image: https://hub.docker.com/r/dxflrs/garage)
GARAGE_VERSION=v2.6.0

# ── Host exposure ──────────────────────────────────────────────────────────
#   127.0.0.1 = host-only; reach via your reverse proxy (recommended)
#   0.0.0.0   = reachable on the LAN (bypasses UFW — hardening 07)
# Applies to the S3 API port only; the admin port is always pinned to 127.0.0.1.
LISTEN_ADDR=0.0.0.0
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903
# GARAGE_WEB_PORT=3902

# ── Resource limits ────────────────────────────────────────────────────────
GARAGE_MEM_LIMIT=512m
GARAGE_MEM_RESERVATION=128m
GARAGE_CPUS=1.0
GARAGE_PIDS_LIMIT=100
