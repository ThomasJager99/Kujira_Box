# Images
GITEA_IMAGE=gitea/gitea:1
POSTGRES_IMAGE=postgres:16

# Ports (host side). Container listens on 3000 (web) and 22 (git over SSH).
# SSH is published on 222 to avoid clashing with the host's own sshd on 22.
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=222

# Public address — used to build clone URLs and links. Set to your real
# host/domain (e.g. http://192.168.1.50:3000/ or https://git.example.com/).
GITEA_DOMAIN=localhost
GITEA_ROOT_URL=http://localhost:3000/

# Database — used by BOTH the db container and Gitea (keep in sync)
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=CHANGE_ME_db_password

# Memory limit for the Gitea app
GITEA_MEM_LIMIT=1g
