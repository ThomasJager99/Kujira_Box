# ── Infisical ──────────────────────────────────────────────────────────────
# Copy to .env and fill in. These ARE real secrets — keep this file out of git
# (and see hardening entry 14 about graduating them beyond plaintext .env).

# Image versions. Pin all three. Infisical releases:
# https://github.com/Infisical/infisical/releases  (verify the exact image tag
# on Docker Hub: https://hub.docker.com/r/infisical/infisical/tags)
INFISICAL_VERSION=v0.167.14
POSTGRES_VERSION=16-alpine
REDIS_VERSION=7-alpine

# Public URL the app is reached on. Behind a reverse proxy this is your https host.
SITE_URL=http://localhost:8080

# ── Core secrets (generate these, keep them STABLE) ───────────────────────
# Root encryption key (16-byte hex):   openssl rand -hex 16
ENCRYPTION_KEY=
# Auth / JWT signing secret (base64):   openssl rand -base64 32
AUTH_SECRET=

# ── Host exposure ──────────────────────────────────────────────────────────
#   127.0.0.1 = host-only; reach via your reverse proxy (recommended)
#   0.0.0.0   = reachable on the LAN (bypasses UFW — hardening 07)
LISTEN_ADDR=0.0.0.0
INFISICAL_PORT=8080

# ── Database (internal, not exposed) ──────────────────────────────────────
POSTGRES_USER=infisical
POSTGRES_DB=infisical
# Generate a strong one:  openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Resource limits ───────────────────────────────────────────────────────
INFISICAL_MEM_LIMIT=1g
INFISICAL_CPUS=1.0
INFISICAL_PIDS_LIMIT=300
POSTGRES_MEM_LIMIT=512m
POSTGRES_CPUS=1.0
POSTGRES_PIDS_LIMIT=200
REDIS_MEM_LIMIT=256m
REDIS_CPUS=0.5
REDIS_PIDS_LIMIT=100
