# n8n — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Image ---
N8N_IMAGE=docker.n8n.io/n8nio/n8n
N8N_VERSION=latest

# --- Networking ---
N8N_PORT=5678
# The hostname/IP clients use to reach n8n (no scheme, no port).
N8N_HOST=localhost
# http on a trusted LAN, https behind a reverse proxy.
N8N_PROTOCOL=http
# Full public base URL used to build webhook links (keep the trailing slash).
N8N_WEBHOOK_URL=http://localhost:5678/

# --- Timezone (Cron/Schedule nodes) ---
TZ=Etc/UTC

# --- Security ---
# REQUIRED. Encrypts saved credentials. Generate once and keep it stable:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# true = require secure (HTTPS) cookies. Set false only for plain-HTTP LAN use.
N8N_SECURE_COOKIE=true

# --- Resource limits ---
N8N_MEM_LIMIT=1g
N8N_MEM_RESERVATION=256m
N8N_CPUS=1.0
