# Nginx Proxy Manager — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Image ---
NPM_IMAGE=jc21/nginx-proxy-manager
NPM_VERSION=latest

# --- Ports ---
NPM_HTTP_PORT=80     # must be reachable from the internet for Let's Encrypt HTTP validation
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81    # admin UI — keep it LAN/VPN only, do not expose publicly

# --- Timezone ---
TZ=Etc/UTC

# --- Resource limits ---
NPM_MEM_LIMIT=512m
NPM_MEM_RESERVATION=128m
NPM_CPUS=1.0
