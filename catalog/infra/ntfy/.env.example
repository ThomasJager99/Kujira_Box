# Image
NTFY_IMAGE=binwiederhier/ntfy:latest

# Web / API port (host side; container serves on 80)
NTFY_PORT=8090

# Public URL of this ntfy server — set to the address you actually use
# (e.g. http://100.78.53.13:8090 or https://ntfy.example.com)
NTFY_BASE_URL=http://localhost:8090

TZ=Europe/Berlin

# Memory limit (ntfy is tiny)
NTFY_MEM_LIMIT=128m
