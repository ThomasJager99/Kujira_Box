# SearXNG — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Image ---
SEARXNG_IMAGE=searxng/searxng
# SearXNG uses rolling date/commit tags; 'latest' tracks newest. Pin a specific
# tag from the registry if you want fully reproducible rebuilds.
SEARXNG_VERSION=latest

# --- Networking ---
SEARXNG_PORT=8080
# Must match how users actually reach it (scheme + host [+ port], trailing slash).
SEARXNG_BASE_URL=http://localhost:8080/
SEARXNG_INSTANCE_NAME=SearXNG

# --- Resource limits ---
SEARXNG_MEM_LIMIT=512m
SEARXNG_MEM_RESERVATION=64m
SEARXNG_CPUS=1.0
