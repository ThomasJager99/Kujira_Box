# ── Stalwart Mail ──────────────────────────────────────────────────────────
# Copy to .env and adjust. The admin password is generated on first run and
# printed in the container logs — grab it there, then change it in the web UI.

# Image version. Pin it. Releases:
# https://github.com/stalwartlabs/stalwart/releases
STALWART_VERSION=v1.1.0

# The FQDN of your mail server. Must match your DNS (A/AAAA + the MX target)
# and your reverse DNS (PTR). This is the single most important value.
MAIL_HOSTNAME=mail.example.com

# ── Web admin / JMAP exposure ──────────────────────────────────────────────
# The admin UI + JMAP port. Mail protocol ports (25/465/587/143/993) are always
# public in the compose; only THIS one honors LISTEN_ADDR.
#   127.0.0.1 = admin UI host-only; reach it via your reverse proxy (recommended)
#   0.0.0.0   = admin UI reachable on the LAN
LISTEN_ADDR=0.0.0.0
STALWART_WEB_PORT=8080

# Timezone.
TZ=Europe/Berlin

# ── Resource limits ───────────────────────────────────────────────────────
STALWART_MEM_LIMIT=2g
STALWART_CPUS=2.0
STALWART_PIDS_LIMIT=400
