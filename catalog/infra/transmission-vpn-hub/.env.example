# ── VPN provider (gluetun) ───────────────────────────────────────────────────
# WireGuard example with a named provider. Full list + required keys:
# https://github.com/qdm12/gluetun-wiki
VPN_PROVIDER=mullvad
WIREGUARD_PRIVATE_KEY=CHANGE_ME_wireguard_private_key
WIREGUARD_ADDRESSES=10.0.0.2/32
SERVER_COUNTRIES=Germany

# To use YOUR OWN WireGuard server instead of a commercial provider, set
# VPN_PROVIDER=custom above and add (see gluetun wiki):
#   WIREGUARD_ENDPOINT_IP=...
#   WIREGUARD_ENDPOINT_PORT=51820
#   WIREGUARD_PUBLIC_KEY=...      (the server's public key)

# Your LAN subnet — required so you can open the web UIs from your network.
LAN_SUBNET=192.168.1.0/24

# ── Ports (published on gluetun) ─────────────────────────────────────────────
TRANSMISSION_PORT=9091

# ── User / paths / misc ──────────────────────────────────────────────────────
PUID=1000
PGID=1000
CONFIG_PATH=./config
DOWNLOADS_PATH=./downloads
TZ=Europe/Berlin

TRANSMISSION_MEM_LIMIT=512m
