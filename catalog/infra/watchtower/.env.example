# Watchtower — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Image ---
WATCHTOWER_IMAGE=containrrr/watchtower
WATCHTOWER_VERSION=latest

# --- Timezone (affects the schedule) ---
TZ=Etc/UTC

# --- When to check (6-field cron: sec min hour dom mon dow) ---
WATCHTOWER_SCHEDULE=0 0 4 * * *     # every day at 04:00

# --- Behaviour ---
WATCHTOWER_CLEANUP=true             # delete old images after updating
WATCHTOWER_ROLLING_RESTART=true     # update containers one at a time
WATCHTOWER_LABEL_ENABLE=true        # true = only labelled containers; false = all
WATCHTOWER_MONITOR_ONLY=false       # true = report updates but don't apply them

# --- Notifications (optional, shoutrrr URL) ---
# Push to your ntfy server, e.g.:
# WATCHTOWER_NOTIFICATION_URL=ntfy://ntfy.example.com/watchtower

# --- Resource limits ---
WATCHTOWER_MEM_LIMIT=256m
WATCHTOWER_MEM_RESERVATION=32m
WATCHTOWER_CPUS=0.5
