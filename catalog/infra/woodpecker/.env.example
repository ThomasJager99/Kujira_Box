# ── Woodpecker CI ────────────────────────────────────────────────────────────
# Copy to .env and fill in. Pin the version; keep the secrets out of git.

# Server + agent MUST run the same version. Check the release tag:
# https://github.com/woodpecker-ci/woodpecker/releases
WOODPECKER_VERSION=v3.20.1

# ── Public address ──────────────────────────────────────────────────────────
# The URL users (and the forge OAuth redirect) reach the server on.
WOODPECKER_HOST=https://ci.example.com
WOODPECKER_WEB_PORT=8000
WOODPECKER_GRPC_PORT=9000

# false = server is closed; admins add repositories manually (recommended).
# true  = any forge user who logs in can enable their own repos.
WOODPECKER_OPEN=false
# Comma-separated forge usernames who are Woodpecker admins (at least you).
WOODPECKER_ADMIN=your-gitea-username

# ── Forge: Gitea ──────────────────────────────────────────────────────────
# In Gitea: Settings → Applications → create an OAuth2 app.
#   Redirect URI = ${WOODPECKER_HOST}/authorize
# Then paste the generated client id + secret here.
WOODPECKER_GITEA_URL=https://git.example.com
WOODPECKER_GITEA_CLIENT=
WOODPECKER_GITEA_SECRET=

# ── Shared agent secret ─────────────────────────────────────────────────────
# Authenticates agents to the server. Generate once, use the SAME value for
# both server and agent:   openssl rand -hex 32
WOODPECKER_AGENT_SECRET=

# ── Agent ───────────────────────────────────────────────────────────────────
# How the agent reaches the server's gRPC port. Default works inside this stack.
WOODPECKER_AGENT_SERVER=server:9000
# How many pipeline workflows this agent runs in parallel.
WOODPECKER_MAX_WORKFLOWS=2

# ── Resource limits ───────────────────────────────────────────────────────
WOODPECKER_SERVER_MEM_LIMIT=512m
WOODPECKER_SERVER_CPUS=1.0
WOODPECKER_AGENT_MEM_LIMIT=1g
WOODPECKER_AGENT_CPUS=2.0
