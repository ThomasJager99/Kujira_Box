# ── Calibre-Web ────────────────────────────────────────────────────────────
# Copy to .env and adjust. No secrets here — the admin password is set in the
# web UI on first login (default admin / admin123 → change immediately).

# Image version. LinuxServer.io also publishes bare semver for calibre-web
# (e.g. 0.6.27). Pin it rather than `latest`:
# https://github.com/linuxserver/docker-calibre-web/pkgs/container/calibre-web
CALIBRE_WEB_VERSION=0.6.27

# Host port → container :8083
CALIBRE_WEB_PORT=8083

# Path to your Calibre LIBRARY (the folder with metadata.db). If you don't have
# one yet, point this at an empty dir and create the library from the web UI.
BOOKS_PATH=/path/to/calibre/library

# LinuxServer ownership + timezone. Match PUID/PGID to the owner of BOOKS_PATH.
PUID=1000
PGID=1000
TZ=Europe/Berlin

# E-book conversion / send-to-kindle. Leave as-is to enable, or set empty to
# skip the Calibre binaries:  CALIBRE_WEB_MODS=
CALIBRE_WEB_MODS=linuxserver/mods:universal-calibre

# ── Resource limits ───────────────────────────────────────────────────────
CALIBRE_WEB_MEM_LIMIT=512m
CALIBRE_WEB_CPUS=1.0
