# Version & pinned images (from the official Immich compose)
IMMICH_VERSION=release
REDIS_IMAGE=docker.io/valkey/valkey:9@sha256:c123e3715db63d06d4ad6964884037aa0d5d4d703939b9929954112889708e1d
DB_IMAGE=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23

# Web port (host side; container listens on 2283)
IMMICH_PORT=2283

# Where your photos/videos are stored on the host (bind mount)
UPLOAD_LOCATION=./library

# Where Postgres data lives on the host — MUST be a real local filesystem,
# not a network share (NFS/SMB), or the database will misbehave.
DB_DATA_LOCATION=./postgres

TZ=Europe/Berlin

# Database credentials (used by the database container AND the server)
DB_PASSWORD=CHANGE_ME_db_password
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Memory limits
IMMICH_MEM_LIMIT=2g
IMMICH_ML_MEM_LIMIT=3g
