# Image
JELLYFIN_IMAGE=jellyfin/jellyfin:latest

# Web port (host side; container listens on 8096)
JELLYFIN_PORT=8096

# Public URL clients should use to reach the server — set to your real address
# (e.g. http://192.168.1.50:8096 or https://jellyfin.example.com)
JELLYFIN_PUBLISHED_URL=http://localhost:8096

TZ=Europe/Berlin

# Host path to your media library (mounted read-only into the container).
# Point this at where your movies/shows/music actually live.
MEDIA_PATH=./media

# Memory limit
JELLYFIN_MEM_LIMIT=2g
