# Jellyseerr — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Image ---
JELLYSEERR_IMAGE=fallenbagel/jellyseerr
# Pin to a specific release tag for reproducibility. NOTE: the project is
# rebranding Jellyseerr -> "Seerr" (repo seerr-team/seerr; latest release v3.5.0
# at the time this was written). Check the registry and pin the tag you want,
# e.g. JELLYSEERR_VERSION=2.5.0  (using 'latest' here only as a safe placeholder).
JELLYSEERR_VERSION=latest

# --- Networking ---
JELLYSEERR_PORT=5055

# --- Behaviour ---
TZ=Etc/UTC
JELLYSEERR_LOG_LEVEL=info     # debug | info | warn | error

# --- Resource limits ---
JELLYSEERR_MEM_LIMIT=512m
JELLYSEERR_MEM_RESERVATION=128m
JELLYSEERR_CPUS=1.0
