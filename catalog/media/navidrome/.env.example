# Image
NAVIDROME_IMAGE=deluan/navidrome:latest

# Web / Subsonic-API port (host side; container listens on 4533)
NAVIDROME_PORT=4533

# User the container runs as — must own DATA_PATH and be able to read the music
NAVIDROME_UID=1000
NAVIDROME_GID=1000

# Host paths (bind mounts)
DATA_PATH=./data           # Navidrome database & config (read/write)
MUSIC_PATH=./music         # your music library (mounted read-only)

TZ=Europe/Berlin

# Memory limit (Navidrome is light)
NAVIDROME_MEM_LIMIT=256m
