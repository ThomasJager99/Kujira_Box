# Prowlarr — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Image ---
PROWLARR_IMAGE=lscr.io/linuxserver/prowlarr
# LinuxServer publishes 'latest' plus release tags (e.g. 1.x.x-lsNNN). Pin a
# release tag from the registry if you want reproducible rebuilds.
PROWLARR_VERSION=latest

# --- File ownership (match the user that owns the config volume/host path) ---
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- Networking ---
PROWLARR_PORT=9696

# --- Resource limits ---
PROWLARR_MEM_LIMIT=512m
PROWLARR_MEM_RESERVATION=64m
PROWLARR_CPUS=1.0
