# qBittorrent + gluetun (VPN) — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Images ---
GLUETUN_IMAGE=qmcgaw/gluetun
GLUETUN_VERSION=latest        # pin a release (e.g. v3.x.x) for reproducibility
QBT_IMAGE=lscr.io/linuxserver/qbittorrent
QBT_VERSION=latest            # LSIO: pin a 4.x.x-lsNNN tag if you want

# --- File ownership ---
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- Ports (published on gluetun) ---
QBT_WEBUI_PORT=8080
QBT_TORRENT_PORT=6881

# --- VPN (gluetun) ---
# Your provider's name (mullvad, protonvpn, ...) OR 'custom' for your own tunnel.
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=10.0.0.2/32    # the address your provider assigns you
SERVER_COUNTRIES=                   # optional, e.g. Netherlands
# Your LAN subnet(s) so you can open the Web UI through the kill-switch.
FIREWALL_OUTBOUND_SUBNETS=192.168.0.0/16

# --- Downloads location ---
DOWNLOADS_PATH=./downloads

# --- Resource limits ---
GLUETUN_MEM_LIMIT=256m
GLUETUN_MEM_RESERVATION=32m
GLUETUN_CPUS=1.0
QBT_MEM_LIMIT=1g
QBT_MEM_RESERVATION=128m
QBT_CPUS=2.0
