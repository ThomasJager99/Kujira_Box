# Radarr — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Image ---
RADARR_IMAGE=lscr.io/linuxserver/radarr
# LinuxServer publishes 'latest' plus release tags (e.g. 5.x.x-lsNNN). Pin a
# release tag from the registry if you want reproducible rebuilds.
RADARR_VERSION=latest

# --- File ownership (match the user that owns your media/downloads) ---
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- Networking ---
RADARR_PORT=7878

# --- Host paths (IMPORTANT: put movies + downloads under ONE parent so Radarr
#     can hardlink/atomic-move instead of slow copies; see README) ---
MOVIES_PATH=./movies
DOWNLOADS_PATH=./downloads

# --- Resource limits ---
RADARR_MEM_LIMIT=1g
RADARR_MEM_RESERVATION=128m
RADARR_CPUS=1.0
