# Sonarr — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Image ---
SONARR_IMAGE=lscr.io/linuxserver/sonarr
# LinuxServer publishes 'latest' plus release tags (e.g. 4.x.x-lsNNN). Pin a
# release tag from the registry if you want reproducible rebuilds.
SONARR_VERSION=latest

# --- File ownership (match the user that owns your media/downloads) ---
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- Networking ---
SONARR_PORT=8989

# --- Host paths (IMPORTANT: put TV + downloads under ONE parent so Sonarr can
#     hardlink/atomic-move instead of slow copies; see README) ---
TV_PATH=./tv
DOWNLOADS_PATH=./downloads

# --- Resource limits ---
SONARR_MEM_LIMIT=1g
SONARR_MEM_RESERVATION=128m
SONARR_CPUS=1.0
