# Dozzle — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Image ---
DOZZLE_IMAGE=amir20/dozzle
DOZZLE_VERSION=latest

# --- Networking ---
DOZZLE_PORT=8080

# --- Behaviour ---
DOZZLE_LEVEL=info          # log verbosity of Dozzle itself: debug | info | warn | error

# --- Auth ---
# none  = no login (use only on a trusted LAN / behind a reverse proxy with auth)
# simple = built-in username/password (also mount a users file, see the docs)
DOZZLE_AUTH_PROVIDER=none

# --- Resource limits ---
DOZZLE_MEM_LIMIT=256m
DOZZLE_MEM_RESERVATION=64m
DOZZLE_CPUS=0.5
