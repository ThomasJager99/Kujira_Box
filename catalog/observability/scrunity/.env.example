# Scrutiny — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Image ---
SCRUTINY_IMAGE=ghcr.io/analogj/scrutiny
SCRUTINY_VERSION=master-omnibus

# --- Networking ---
SCRUTINY_PORT=8080

# --- Collector schedule (standard cron) ---
SCRUTINY_CRON=0 1 * * *     # scan disks every day at 01:00

# --- Resource limits ---
SCRUTINY_MEM_LIMIT=1g
SCRUTINY_MEM_RESERVATION=256m
SCRUTINY_CPUS=1.0
