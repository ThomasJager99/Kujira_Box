# ── Speedtest Tracker ──────────────────────────────────────────────────────
# Copy to .env and fill in. Keep APP_KEY stable once set.

# Image version. Pin it (project publishes semver tags):
# https://github.com/alexjustesen/speedtest-tracker/pkgs/container/speedtest-tracker
SPEEDTEST_VERSION=v1.15.1

# Laravel application key — REQUIRED, generate ONCE and never change it after
# first run (it's used to encrypt stored settings):
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# Public URL you reach the dashboard on (used for asset/link generation).
APP_URL=http://localhost:8765

# Host port → container :80
SPEEDTEST_PORT=8765

# Test schedule (cron). Examples:
#   0 * * * *      every hour on the hour (default)
#   */30 * * * *   every 30 minutes
#   0 */6 * * *    every 6 hours
SPEEDTEST_SCHEDULE=0 * * * *

# Optional: comma-separated Ookla server IDs to pin. Empty = auto-select.
SPEEDTEST_SERVERS=

# Ownership + timezone (so schedules/timestamps are in your local time).
PUID=1000
PGID=1000
TZ=Europe/Berlin

# ── Resource limits ───────────────────────────────────────────────────────
SPEEDTEST_MEM_LIMIT=512m
SPEEDTEST_CPUS=1.0
SPEEDTEST_PIDS_LIMIT=200
