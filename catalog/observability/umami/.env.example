# Umami — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Images (PINNED) ---
UMAMI_IMAGE=ghcr.io/umami-software/umami
UMAMI_VERSION=postgresql-v3.4.1    # verify the exact tag in the registry
POSTGRES_IMAGE=postgres
POSTGRES_VERSION=16-alpine

# --- Networking ---
UMAMI_PORT=3000

# --- Security ---
# Signs auth tokens. Generate once and keep stable: openssl rand -hex 32
UMAMI_APP_SECRET=

# --- Database (PostgreSQL) ---
POSTGRES_DB=umami
POSTGRES_USER=umami
POSTGRES_PASSWORD=

# --- Resource limits ---
UMAMI_MEM_LIMIT=512m
UMAMI_MEM_RESERVATION=128m
UMAMI_CPUS=1.0
POSTGRES_MEM_LIMIT=512m
POSTGRES_MEM_RESERVATION=128m
POSTGRES_CPUS=1.0
